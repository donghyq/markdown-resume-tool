{
  "name": "markdown-resume-tool",
  "version": "1.0.0",
  "private": true,
  "description": "离线 Markdown 简历编辑器与 A4 HTML / PDF 导出工具",
  "license": "MIT",
  "author": "donghyq",
  "homepage": "https://github.com/donghyq/markdown-resume-tool#readme",
  "repository": { "type": "git", "url": "https://github.com/donghyq/markdown-resume-tool.git" },
